{
  "name": "touchpass-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json --config ./vite.config.ts --fail-on-warnings",
    "test": "vitest run",
    "test:gate": "pnpm run check && pnpm test && pnpm run build",
    "clean": "powershell -ExecutionPolicy Bypass -File scripts/clean-workspace.ps1 -Days 7",
    "clean:full": "powershell -ExecutionPolicy Bypass -File scripts/clean-workspace.ps1 -FullClean",
    "optimize:defender": "powershell -ExecutionPolicy Bypass -File scripts/add-defender-exclusion.ps1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "lucide-svelte": "^0.468.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.4",
    "@tsconfig/svelte": "^5.0.4",
    "jsdom": "^29.1.1",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
